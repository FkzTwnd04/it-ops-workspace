# IT 智能工单系统 环境变量模板
# 使用方式：复制为 .env.local 后填入真实值（.env.local 已被 .gitignore 忽略，不要提交）

# ── PostgreSQL（docker-compose 对外端口 5433）──
DB_HOST=localhost
DB_PORT=5433
DB_NAME=it_ticket
DB_USER=it_ticket
DB_PASSWORD=change-me

# ── Milvus（docker-compose 对外端口 19531）──
MILVUS_HOST=localhost
MILVUS_PORT=19531

# ── Redis（工单并发锁 / SLA 巡检锁，docker-compose 对外端口 6380）──
REDIS_URL=redis://localhost:6380/0

# ── MinIO（Milvus 内部对象存储，可不改）──
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── 大模型：DeepSeek（OpenAI 兼容接口）──
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── 本地模型权重（相对 backend/ 目录）──
BGE_M3_MODEL_PATH=models/embedding/bge-m3
RERANKER_MODEL_PATH=models/reranker/bge-reranker-large

# ── JWT：生成方式 python -c "import secrets; print(secrets.token_urlsafe(48))" ──
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── 工单业务参数 ──
SLA_SCAN_INTERVAL_SECONDS=60
RETRIEVAL_CONFIDENCE_THRESHOLD=0.6
RESOLUTION_CONFIDENCE_THRESHOLD=0.7

# ── 应用 ──
APP_ENV=local
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
DEFAULT_TENANT_ID=it_hq
